
APP_NAME=Enterprise Engineering Copilot
APP_ENV=development
LOG_LEVEL=INFO

MODEL_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Phase 3 local RAG
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
CHROMA_PERSIST_DIRECTORY=rag_data/chroma
CHROMA_COLLECTION_NAME=engineering_documents
DOCUMENT_STORAGE_DIRECTORY=rag_data/documents
RAG_METADATA_DATABASE=rag_data/metadata.db
MAX_UPLOAD_SIZE_BYTES=10485760
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RAG_TOP_K=5
RAG_CONTEXT_CHAR_LIMIT=12000
RAG_ADJACENT_CHUNK_RADIUS=2
RAG_SOURCE_EXCERPT_CHAR_LIMIT=500
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_MAX_RETRIES=3

# Phase 4.6 repository access
REPOSITORY_WORKSPACE_ROOT=rag_data/repositories
ALLOWED_LOCAL_REPOSITORY_ROOTS=["D:\\Projects\\VelikanDovera"]
MAXIMUM_REPOSITORY_SIZE_BYTES=1073741824
MAXIMUM_REPOSITORY_FILE_SIZE_BYTES=10485760
MAXIMUM_REPOSITORY_FILE_COUNT=50000
MAXIMUM_DIRECTORY_TRAVERSAL_DEPTH=20
WORKSPACE_RETENTION_SECONDS=86400
GIT_EXECUTABLE_PATH=git
GITHUB_ALLOWED_HOSTS=["github.com"]