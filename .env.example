
APP_NAME=Enterprise Engineering Copilot
APP_ENV=development
LOG_LEVEL=INFO

MODEL_PROVIDER=openai

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini


# Model provider
MODEL_PROVIDER=foundry

# Microsoft Foundry
FOUNDRY_PROJECT_ENDPOINT=https://enterprise-engineering-copilot-foundry.services.ai.azure.com/api/projects/engineering-copilot
FOUNDRY_MODEL=gpt-5-mini
FOUNDRY_EMBEDDING_MODEL=text-embedding-3-small

# RAG
RAG_BACKEND=azure
# RAG_BACKEND=memory
RAG_EMBEDDING_DIMENSIONS=1536

# Incoming API authentication (required for Azure RAG)
ENTRA_TENANT_ID=
ENTRA_API_CLIENT_ID=
ENTRA_REQUIRED_SCOPE=access_as_user

# Azure AI Search
AZURE_SEARCH_ENDPOINT=https://eec-ai-search.search.windows.net
AZURE_SEARCH_INDEX_NAME=engineering-knowledge

# Azure Blob Storage
AZURE_STORAGE_ACCOUNT_URL=https://eecopilotdocs.blob.core.windows.net
AZURE_STORAGE_CONTAINER=engineering-documents